# AETHER Autonomous Agent Environment Configuration

# --- LLM API Provider (OpenAI Compatible) ---
# Supports: openai, deepseek, openrouter, ollama, anthropic, gemini, etc.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_or_deepseek_or_openrouter_api_key
LLM_MODEL=gpt-4o-mini

# Examples for other providers:
# DeepSeek:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-3.5-sonnet

# Local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3

# --- Exchange Live API Keys (When going live) ---
POLYMARKET_API_KEY=your_polygon_private_key
HYPERLIQUID_API_KEY=your_hyperliquid_api_key
KALSHI_API_KEY=your_kalshi_api_key
# --- Kalshi Demo Credentials ---
KALSHI_DEMO_KEY_ID=your_demo_key_id
KALSHI_DEMO_KEY_FILE=your_demo_key_file
KALSHI_BASE_URL=https://demo-api.kalshi.com
